#!/usr/bin/env ruby
# SPDX-FileCopyrightText: Copyright (c) 2014-2026 Yegor Bugayenko
# SPDX-License-Identifier: MIT

STDOUT.sync = true

require 'slop'
require 'nokogiri'
require 'est'
require 'est/version'

opts =
  Slop.parse(ARGV) do |options|
    options.banner = "Usage (#{Est::VERSION}): est [options]"
    options.bool('-v', '--verbose', 'Enable verbose mode')
    options.bool('--version', 'Show current version')
    options.bool('-h', '--help', 'Show this message')
    options.string('-d', '--dir', 'Source directory to parse')
    options.string('-f', '--file', 'File to save output into')
    options.string('-t', '--format', 'Format to use (xml|html|text)')
  end

raise '-f is mandatory when using -v' if opts.verbose? && !opts.file?

if opts.help?
  puts opts
  exit
end

if opts.version?
  puts Est::VERSION
  exit
end

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
if opts.file?
  file = File.new(opts[:file], 'w')
  Est.log.info("output saving into #{file.path}")
else
  file = STDOUT
end
output = Est::Base.new(opts).xml
if opts[:format].nil? || opts[:format] == 'text'
  xslt = File.join(File.dirname(File.dirname(__FILE__)), 'assets', 'est-text.xsl')
  output = Nokogiri::XSLT(File.read(xslt)).apply_to(Nokogiri::XML(output))
elsif opts[:format] == 'html'
  Est.log.info('using HTML format')
  xslt = File.join(File.dirname(File.dirname(__FILE__)), 'assets', 'est.xsl')
  output = Nokogiri::XSLT(File.read(xslt)).transform(Nokogiri::XML(output))
elsif opts[:format] == 'xml'
  Est.log.info('using XML format')
else
  raise 'invalid format, use html, text, or xml'
end
file << output
